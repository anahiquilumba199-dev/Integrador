# SQL Server local. Para RDS usa tcp:ENDPOINT,1433 y un usuario SQL de la aplicación.
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost
DB_NAME=EcoRAEE
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=yes
# Solo para una instancia de desarrollo con certificado local no confiable.
DB_TRUST_SERVER_CERTIFICATE=yes
# Opcional. Usa ecoraee_app si el catálogo contiene el esquema de RAEE.bak.
DB_SCHEMA=
DB_INITIALIZE=true

# Genera un valor aleatorio distinto de al menos 32 caracteres.
AUTH_SECRET=
# Se usan una sola vez si todavía no existe un administrador.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Orígenes adicionales separados por comas (solo si la API está en otro dominio).
CORS_ORIGINS=
